# ==========================================
# CONFIGURAÇÃO DE PRODUÇÃO
# ==========================================
# Copie este arquivo para .env.production e preencha os valores

# ==========================================
# SEGURANÇA
# ==========================================

# Chave secreta compartilhada entre Next.js e Backend Java
# IMPORTANTE: Use uma chave forte de pelo menos 32 caracteres
# Gere com: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_TO_STRONG_SECRET_KEY_MIN_32_CHARS
JWT_SECRET=CHANGE_ME_TO_STRONG_SECRET_KEY_MIN_32_CHARS

# ==========================================
# URLs E DOMÍNIOS
# ==========================================

# URL pública da aplicação (domínio de produção)
# Usado pelo Better Auth para callbacks OAuth

BETTER_AUTH_URL=https://seu-dominio.com

# URL da API Backend Java (através do Nginx)
# Em produção, usa o Nginx como proxy reverso
# O Nginx redireciona /api/v1/* para o backend Java (porta 8080)
NEXT_PUBLIC_API_URL=https://seu-dominio.com/api/v1

# ==========================================
# BANCO DE DADOS (PostgreSQL)
# ==========================================

POSTGRES_DB=tickets
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Spring Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tickets
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ==========================================
# OAUTH PROVIDERS
# ==========================================

# Google OAuth
# Obtenha as credenciais em: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (opcional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Microsoft OAuth (opcional)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ==========================================
# BACKEND JAVA (Spring Boot)
# ==========================================

SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

# Logging
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_TICKETS=INFO

# Java Heap Size
JAVA_OPTS=-Xms512m -Xmx2g

SERVER_PORT=8080

# ==========================================
# NEXT.JS
# ==========================================

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# ==========================================
# NGINX - ARQUITETURA DE ROTAS
# ==========================================
#
# Cliente (Browser) → Nginx (porta 80/443)
#     ├─→ /api/auth/*  → Next.js:3000  (Better Auth - autenticação OAuth)
#     ├─→ /api/v1/*    → Java:8080     (Backend API - rewrite remove /api/v1)
#     └─→ /*           → Next.js:3000  (Frontend + SSR + outras rotas)
#
# IMPORTANTE:
# - /api/auth/* não conflita com /api/v1/* (rotas separadas)
# - Backend Java recebe requisições sem o prefixo /api/v1
# - Cliente sempre usa https://seu-dominio.com/api/v1/* para o backend
# - Nginx faz o rewrite: /api/v1/users → http://java:8080/users

# ==========================================
# MONITORAMENTO (opcional)
# ==========================================

# Sentry (Error tracking)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
#
# 1. NUNCA commite o arquivo .env.production com valores reais
# 2. Use secrets management em produção
# 3. Rotacione AUTH_SECRET/JWT_SECRET periodicamente
# 4. Configure SSL/TLS certificates no Nginx (docker/nginx/ssl/)
# 5. Configure backup automático do banco de dados
# 6. Configure monitoramento de logs

